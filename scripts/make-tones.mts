/**
 * Makes the reference tones the app plays: one short sound file per note.
 * Run with: node scripts/make-tones.mts
 *
 * It writes assets/tones/<note number>.wav and src/data/tones.ts, the list
 * the app reads. Both are generated. Change this script, not those files.
 *
 * Each tone is the note plus a few quieter overtones. A phone speaker cannot
 * play the lowest notes' fundamentals, but the ear still hears the right
 * pitch from the overtones.
 */
import { mkdirSync, writeFileSync } from 'node:fs';

import { midiToHz, noteName } from '../src/lib/notes.ts';
import { HIGHEST_TARGET, LOWEST_TARGET } from '../src/lib/practice.ts';
import { writeWav } from '../src/lib/wav.ts';

const LOWEST = LOWEST_TARGET;
const HIGHEST = HIGHEST_TARGET;
const RATE = 16_000;
const SECONDS = 1.2;
const OVERTONES = [1, 0.5, 0.3, 0.15];
const FADE_IN = 0.03;
const FADE_OUT = 0.3;

function tone(hz: number): Float32Array {
  const count = Math.round(RATE * SECONDS);
  const total = OVERTONES.reduce((sum, value) => sum + value, 0);
  const out = new Float32Array(count);
  for (let i = 0; i < count; i++) {
    const seconds = i / RATE;
    let sample = 0;
    for (let k = 0; k < OVERTONES.length; k++) {
      sample += OVERTONES[k] * Math.sin(2 * Math.PI * hz * (k + 1) * seconds);
    }
    const fade = Math.min(1, seconds / FADE_IN, (SECONDS - seconds) / FADE_OUT);
    out[i] = (0.8 * sample * fade) / total;
  }
  return out;
}

mkdirSync('assets/tones', { recursive: true });
mkdirSync('src/data', { recursive: true });

const lines: string[] = [];
for (let midi = LOWEST; midi <= HIGHEST; midi++) {
  writeFileSync(`assets/tones/${midi}.wav`, writeWav(tone(midiToHz(midi)), RATE));
  lines.push(`  ${midi}: require('../../assets/tones/${midi}.wav'), // ${noteName(midi)}`);
}

writeFileSync(
  'src/data/tones.ts',
  `/**
 * Generated by scripts/make-tones.mts. Do not edit by hand.
 * One reference tone per note, keyed by note number,
 * ${noteName(LOWEST)} to ${noteName(HIGHEST)}.
 */
export const tones: Record<number, number> = {
${lines.join('\n')}
};
`,
);

console.log(`Wrote ${HIGHEST - LOWEST + 1} tones, ${noteName(LOWEST)} to ${noteName(HIGHEST)}.`);
